{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${SCRIBE2_BIN:-scribe2}\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${SCRIBE2_BIN:-scribe2}\" hook pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
