{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${SCRIBE2_BIN:-scribe2}\" hook session-start --pane \"$TMUX_PANE\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${SCRIBE2_BIN:-scribe2}\" hook pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${SCRIBE2_BIN:-scribe2}\" hook permission-request",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${SCRIBE2_BIN:-scribe2}\" hook user-prompt-submit --pane \"$TMUX_PANE\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${SCRIBE2_BIN:-scribe2}\" hook stop --pane \"$TMUX_PANE\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
