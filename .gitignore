/target/
**/*.rs.bk
.DS_Store
*.local.sh
.scribe-envprobe*

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# bd 台帳(Dolt が SSOT) + scribe runtime 生成物の除外（/scribe:setup が収束させる）
.beads/issues.jsonl
.beads/interactions.jsonl
embeddeddolt/
/.beads/scribe-heartbeat
/.beads/scribe-push-throttle
/.beads/scribe-push.log*
/.claude-session/

# spawn worker の worktree（.worktrees/spawn/<branch>）は ephemeral・commit しない
/.worktrees/

# 1 事象 1 行の telemetry（machine-local・実体は .beads 直下）。sc repo の実績形に揃える。
/.beads/bdw-timing.log*
/.beads/dispatch-log.jsonl*
.beads/events.jsonl
